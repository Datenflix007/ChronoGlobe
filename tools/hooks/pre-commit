#!/bin/sh
# ChronoGlobe: vor jedem Commit prüfen, ob die Versionsangaben (?v=…, js/version.js) aktuell sind.
# Einschalten (einmal pro Klon):  git config core.hooksPath tools/hooks
python tools/version_setzen.py --pruefen >/dev/null 2>&1 && exit 0
echo "Versionsangaben veraltet. Bitte ausführen und die geänderten Dateien mit committen:"
echo "    python tools/version_setzen.py"
exit 1
